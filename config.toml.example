# ============================================================================
#  techpanic 配置文件（示例）
# ============================================================================
#  怎么用：
#    1) 把这个文件复制成 data/config.toml
#    2) 按需取消注释、修改
#    3) 重新运行 python -m techpanic
#
#  优先级：命令行参数 > 环境变量(TECHPANIC_*) > 本文件 > 内置默认值
#
#  **不改这个文件也能跑。** 所有项都有合理默认值，这里只列你可能想改的。
# ============================================================================


# ---------------------------------------------------------------- 网络
[network]
# 指数日线数据源。可选 "sina"（新浪，实测稳定）。默认 sina。
source_index = "sina"

# 连接 / 读取超时（秒）
timeout_connect = 5.0
timeout_read    = 15.0

# QVIX（期权隐含波动率）上游 1.optbbs.com 是第三方小站，
# 实测 914 KB 的文件需要 2~4 分钟（服务端限速约 8 KB/s）。
# 单次读超时给到 150 秒；总预算 300 秒用完后立刻改用本地缓存。
timeout_qvix = 150.0
budget_qvix  = 300.0

# 缓存有效期（小时）。QVIX 下载要 2~4 分钟，所以默认 6 小时内已成功抓过
# 就不再重复下载。想每次都抓就设为 0；想立刻重抓用命令行 --refresh。
cache_ttl_hours = 6.0

# 重试次数与退避（秒）。backoff 依次用于第 1、2、3 次重试前的等待。
retries       = 3
retries_qvix  = 2
backoff       = [0.5, 1.5, 4.0]
jitter        = 0.30

# 代理。留空表示直连。公司网络下常用：
#   proxy = "http://127.0.0.1:7890"
# 也可以用环境变量：set TECHPANIC_PROXY=http://127.0.0.1:7890
# proxy = "http://127.0.0.1:7890"


# ---------------------------------------------------------------- 指标定义
#  ⚠️ 改这里之前请先读 docs/METHODOLOGY.md。
#     权重与窗口的任何改动都会让读数不再可比，也会让 tests/ 里的回归基准失效。
[index]
ema_span      = 3       # PI 的 EMA 平滑窗口
z_min_periods = 60      # z-score / 分位的最少样本数
rv_window     = 20      # 长期已实现波动窗口
rv_short      = 5       # 短期已实现波动窗口
annualization = 252     # 年化交易日数

# 分级锚点算法：
#   "expanding"   —— 只用当日及之前的数据（默认，严格无前视）
#   "full_sample" —— 用全样本分位（会引入前视偏差，仅供复现历史报告）
#   "frozen"      —— 用下面 frozen_anchors 里写死的阈值（可复现、可对外引用）
level_anchor = "expanding"

[index.weights]
s = 0.40    # 突发性     （短期波动相对长期波动的抬升）
a = 0.35    # 不对称性   （下跌波动相对上涨波动的放大）
f = 0.25    # 前瞻恐惧   （期权隐含波动率 QVIX 的 z 分数）

# level_anchor = "frozen" 时生效。留空则自动从历史数据推算。
[index.frozen_anchors]
# p25 = 30.0
# p50 = 42.0
# p75 = 58.0
# p90 = 72.0


# ---------------------------------------------------------------- 输出
[output]
formats  = ["csv", "json"]   # 可去掉其中一个
encoding = "utf-8-sig"       # 带 BOM，Excel 双击打开中文不乱码
json_schema = "v1"


# ---------------------------------------------------------------- 界面
[ui]
lang     = "zh-CN"
color    = "auto"    # auto | always | never
progress = true


# ---------------------------------------------------------------- 标的
#  默认跟踪两个科技标的（科创50 + 创业板指）。
#  只有在你想换跟踪对象时才需要取消注释 —— 注意：一旦写了 [targets]，
#  就会**整体替换**默认列表（不是合并）。
#
#  可用的 qvix key：kcb / cyb / 50etf / 300etf / 500etf / 100etf /
#                   1000index / 300index / 50index
#
# [targets.tech_kcb]
# name   = "科创50"
# symbol = "sh000688"      # 新浪格式：sh/sz + 6 位代码
# qvix   = "kcb"
# role   = "tech"          # tech=科技标的；validation=仅方法验证
#
# [targets.tech_cyb]
# name   = "创业板指"
# symbol = "sz399006"
# qvix   = "cyb"
# role   = "tech"
